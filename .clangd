CompileFlags:
  CompilationDatabase: build

Diagnostics:
  # ROS2/system headers trigger many false positives — suppress by pattern
  Suppress:
    - "drv_unknown_argument"
  UnusedIncludes: None

Index:
  Background: Build

InlayHints:
  BlockEnd: No
  Designators: Yes

Completion:
  AllScopes: Yes
