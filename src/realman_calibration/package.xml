<?xml version="1.0"?>
<package format="3">
  <name>realman_calibration</name>
  <version>0.1.0</version>
  <description>C++23 hand-eye calibration pipeline for RealMan robot arms (D435 + OpenCV)</description>
  <maintainer email="dev@realman-driver.com">RealMan Driver Team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>omr_vision</depend>
  <depend>omr_hardware</depend>
  <depend>rclcpp</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
  <test_depend>ament_cmake_gtest</test_depend>
</package>
