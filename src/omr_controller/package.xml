<?xml version="1.0"?>
<package format="3">
  <name>omr_controller</name>
  <version>0.1.0</version>
  <description>Behavior tree-based arm controller with task-space planning for OMR robot</description>
  <maintainer email="dev@realman-driver.com">RealMan Driver Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>behaviortree_cpp</depend>
  <depend>control_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>omr_hardware</depend>
  <depend>omr_vision</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>trajectory_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
