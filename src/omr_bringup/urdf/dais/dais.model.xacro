<?xml version="1.0"?>
<!--
  dais.model.xacro — D-AIS linear rail mechanical model (links + joints only).
  Pure macro library: <robot> provides xml namespace; no self-invocation.
  Designed for <xacro:include> into other xacro files.
-->
<robot name="dais_model" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="dais_ros2_control_model"
               params="track_mesh:=package://omr_bringup/urdf/dais/meshes/track.STL
                       connector_mesh:=package://omr_bringup/urdf/dais/meshes/connector.STL
                       track_origin_x:=0
                       track_origin_y:=0
                       track_origin_z:=0
                        track_origin_roll:=${pi/2}
                        track_origin_pitch:=0
                        track_origin_yaw:=${pi/2}
                        connector_origin_x:=0
                        connector_origin_y:=0
                        connector_origin_z:=0
                        connector_origin_roll:=${pi/2}
                        connector_origin_pitch:=0
                        connector_origin_yaw:=${pi/2}
                       mesh_scale:=0.001
                        track_mass:=10.0
                        slider_mass:=5.0">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  Links                                                      -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- dais_base_link — rail track housing (fixed, STL mesh) -->
    <link name="rail_base">
      <inertial>
        <mass value="${track_mass}"/>
        <inertia ixx="0.5" iyy="0.5" izz="0.5" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <origin xyz="${track_origin_x} ${track_origin_y} ${track_origin_z}"
                rpy="${track_origin_roll} ${track_origin_pitch} ${track_origin_yaw}"/>
        <geometry>
          <mesh filename="${track_mesh}" scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
        </geometry>
        <material name="">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="${track_origin_x} ${track_origin_y} ${track_origin_z}"
                rpy="${track_origin_roll} ${track_origin_pitch} ${track_origin_yaw}"/>
        <geometry>
          <mesh filename="${track_mesh}" scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
        </geometry>
      </collision>
    </link>

    <!-- dais_slider_link — moving connector plate (STL mesh) -->
    <link name="rail_slider">
      <inertial>
        <mass value="${slider_mass}"/>
        <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <origin xyz="${connector_origin_x} ${connector_origin_y} ${connector_origin_z}"
                rpy="${connector_origin_roll} ${connector_origin_pitch} ${connector_origin_yaw}"/>
        <geometry>
          <mesh filename="${connector_mesh}" scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
        </geometry>
        <material name="">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="${connector_origin_x} ${connector_origin_y} ${connector_origin_z}"
                rpy="${connector_origin_roll} ${connector_origin_pitch} ${connector_origin_yaw}"/>
        <geometry>
          <mesh filename="${connector_mesh}" scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
        </geometry>
      </collision>
    </link>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  Joints                                                      -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- Prismatic joint: rail housing → connector plate (Z axis = vertical) -->
    <joint name="joint_dais" type="prismatic">
      <origin xyz="0.00775 -0.002325 0" rpy="0 0 0"/>
      <parent link="rail_base"/>
      <child link="rail_slider"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.27125" upper="0.52425" effort="200" velocity="2.0"/>
    </joint>

  </xacro:macro>

</robot>
