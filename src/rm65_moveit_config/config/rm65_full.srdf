<?xml version="1.0" encoding="utf-8"?>
<robot name="full_robot">

  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="m65_footprint" />

  <group name="arm_group">
    <chain base_link="arm_base" tip_link="arm_link6" />
  </group>

  <group name="endeffector">
    <link name="arm_link6" />
  </group>

  <disable_collisions link1="arm_base" link2="arm_link1" reason="Adjacent" />
  <disable_collisions link1="arm_link1" link2="arm_link2" reason="Adjacent" />
  <disable_collisions link1="arm_link2" link2="arm_link3" reason="Adjacent" />
  <disable_collisions link1="arm_link3" link2="arm_link4" reason="Adjacent" />
  <disable_collisions link1="arm_link4" link2="arm_link5" reason="Adjacent" />
  <disable_collisions link1="arm_link5" link2="arm_link6" reason="Adjacent" />

  <disable_collisions link1="arm_link6" link2="gripper_base_link" reason="Adjacent" />
  <disable_collisions link1="gripper_base_link" link2="gripper_left_1_link" reason="Adjacent" />
  <disable_collisions link1="gripper_base_link" link2="gripper_left_2_link" reason="Adjacent" />
  <disable_collisions link1="gripper_base_link" link2="gripper_right_1_link" reason="Adjacent" />
  <disable_collisions link1="gripper_base_link" link2="gripper_right_2_link" reason="Adjacent" />
  <disable_collisions link1="gripper_left_1_link" link2="gripper_left_support_link" reason="Adjacent" />
  <disable_collisions link1="gripper_right_1_link" link2="gripper_right_support_link" reason="Adjacent" />
  <disable_collisions link1="gripper_left_1_link" link2="gripper_right_1_link" reason="Never" />
  <disable_collisions link1="gripper_left_2_link" link2="gripper_right_2_link" reason="Never" />
  <disable_collisions link1="gripper_left_support_link" link2="gripper_right_support_link" reason="Never" />
  <disable_collisions link1="gripper_left_1_link" link2="gripper_right_2_link" reason="Never" />
  <disable_collisions link1="gripper_right_1_link" link2="gripper_left_2_link" reason="Never" />

</robot>
