// RealMan ROS2 Humble Development Container
// Requires: Docker, VS Code Dev Containers extension, X11 server (for RViz/GUI)
{
	"name": "RealMan ROS2 Humble",
	"dockerComposeFile": "../docker-compose.yml",
	"service": "develop",

	// Mount workspace to /ws (matches Dockerfile WORKDIR)
	"workspaceFolder": "/ws",

	// Build workspace after container creation
	"postCreateCommand": "bash -c 'source /opt/ros/humble/setup.bash && rm -rf /ws/build /ws/install /ws/log && colcon build --symlink-install --cmake-args -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && generate-compile-commands.sh'",

	// VS Code extensions for C++ / ROS2 / CMake development
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cpptools-extension-pack",
				"twxs.cmake",
				"ms-iot.vscode-ros",
				"ms-python.python",
				"xaver.clang-format",
				"llvm-vs-code-extensions.vscode-clangd"
			],
			"settings": {
				"clangd.path": "/usr/bin/clangd-14",
                "dev.containers.logLevel": "trace",
                "remote.autoForwardPorts": false,
				"ros.distro": "humble",
				"C_Cpp.default.cppStandard": "c++23",
				"editor.formatOnSave": false,
				"terminal.integrated.defaultProfile.linux": "zsh",
				"terminal.integrated.profiles.linux": {
					"zsh": {
						"path": "/bin/zsh"
					}
				}
			}
		}
	},

	// Match user created in Dockerfile (uid 1000)
	"remoteUser": "ubuntu",

	// Prevent container from auto-stopping when VS Code disconnects
	"shutdownAction": "none"
}
