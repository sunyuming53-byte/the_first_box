// RealMan ROS2 Humble Development Container
// Requires: Docker, VS Code Dev Containers extension, X11 server (for RViz/GUI)
{
	"name": "RealMan ROS2 Humble",
	"build": {
		"context": "..",
		"dockerfile": "../Dockerfile",
		"target": "realman-develop"
	},

	// Run with host networking for ROS2 DDS discovery and hardware access
	"runArgs": [
		"--network=host",
		"--ipc=host",
		"--pid=host"
	],

	// Mount X11 socket for GUI tools (RViz, Gazebo, etc.)
	// Workspace source is mounted by VS Code automatically at /workspaces/<name>
	"mounts": [
		"type=bind,source=/tmp/.X11-unix,target=/tmp/.X11-unix",
		"type=bind,source=${localEnv:HOME}/.ssh,target=/home/ubuntu/.ssh,readonly"
	],

	// Environment for X11 forwarding and ROS2
	"containerEnv": {
		"DISPLAY": "${localEnv:DISPLAY}",
		"QT_X11_NO_MITSHM": "1",
		"ROS_DOMAIN_ID": "${localEnv:ROS_DOMAIN_ID:0}",
		"RCUTILS_COLORIZED_OUTPUT": "1"
	},

	// Build workspace after container creation
	"postCreateCommand": "bash -c 'source /opt/ros/humble/setup.bash && colcon build --symlink-install'",

	// Ports commonly used for ROS2 / arm communication
	"forwardPorts": [
		8080,   // RM arm API default
		2022    // SSH deploy to runtime container
	],

	// VS Code extensions for C++ / ROS2 / CMake development
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cpptools-extension-pack",
				"ms-vscode.cmake-tools",
				"twxs.cmake",
				"ms-iot.vscode-ros",
				"ms-python.python",
				"xaver.clang-format"
			],
			"settings": {
				"cmake.sourceDirectory": "/ws/src/realman_driver",
				"cmake.buildDirectory": "/ws/build",
				"ros.distro": "humble",
				"C_Cpp.default.cppStandard": "c++23",
				"editor.formatOnSave": false
			}
		}
	},

	// Match user created in Dockerfile (uid 1000)
	"remoteUser": "ubuntu",

	// Prevent container from auto-stopping when VS Code disconnects
	"shutdownAction": "none"
}
