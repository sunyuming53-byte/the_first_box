# Proxy settings for apt/pip/curl behind a local proxy (e.g. Clash, v2ray)
# Copy to .env and customize — .env is git-ignored.
# Leave empty (or comment out) if no proxy is needed.
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890

# ROS2 DDS domain ID — change if multiple ROS2 networks coexist on the same host.
ROS_DOMAIN_ID=0

# Team SSH public key — appended to the runtime container's authorized_keys for deployment.
# Quote the value to preserve spaces.
# Example: TEAM_SSH_PUB_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... user@laptop"
TEAM_SSH_PUB_KEY=""
