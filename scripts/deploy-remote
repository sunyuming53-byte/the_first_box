#!/bin/bash
# Usage: deploy-remote <ip>
# Sync built artifacts to the robot, then restart services.
set -e

if [ $# -lt 1 ]; then
    echo "Usage: deploy-remote <robot-ip>"
    exit 1
fi

echo "=== Deploying to $1 ==="

# Sync artifacts
rsync -avzL --delete \
    -e "ssh -p 2022 -o StrictHostKeyChecking=no" \
    /ws/install/ "root@$1:/ws/install/"

# Restart ROS2 nodes
ssh -p 2022 -o StrictHostKeyChecking=no "root@$1" \
    "supervisorctl restart omrobot"

echo "=== Deploy complete ==="
