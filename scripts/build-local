#!/bin/bash
# Build the ROS2 workspace locally and generate compile_commands for clangd.
# Usage: build-local [--clean]
# Run from the workspace root (WORKDIR /ws in container).
set -euo pipefail

# Source ROS2 Humble — disable -u: ROS2 setup references unbound vars
if [ -f /opt/ros/humble/setup.bash ]; then
    set +u; source /opt/ros/humble/setup.bash; set -u
elif [ -f /opt/ros/humble/setup.zsh ]; then
    set +u; source /opt/ros/humble/setup.zsh; set -u
else
    echo "ERROR: /opt/ros/humble not found. Is ROS2 Humble installed?" >&2
    exit 1
fi

# Clean if requested
if [[ "${1:-}" == "--clean" ]]; then
    echo "Cleaning build artifacts..."
    rm -rf build install log
fi

# Build with compile_commands for clangd
echo "Building workspace..."
colcon build --symlink-install --cmake-args -DCMAKE_EXPORT_COMPILE_COMMANDS=ON

# Merge per-package compile_commands.json into one at build/
echo "Merging compile_commands.json..."
python3 -c "
import json, glob
entries = []
for path in sorted(glob.glob('build/*/compile_commands.json')):
    with open(path) as f:
        entries.extend(json.load(f))
with open('build/compile_commands.json', 'w') as f:
    json.dump(entries, f, indent=2)
print(f'build/compile_commands.json: {len(entries)} entries')
"
